# Supabase PostgreSQL Connection String (Direct)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Supabase Project URL
SUPABASE_URL=https://[PROJECT_ID].supabase.co

# Port the API listens on (optional; hosts like Render set this automatically)
PORT=5000

# Comma-separated list of allowed browser origins (optional; defaults to all).
CORS_ORIGIN=http://localhost:3000

# Allow POST /api/books|clubs/stories to create content (default: false / read-only)
ENABLE_WRITES=false

# Local Ollama endpoint for Rooted AI features
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_MS=120000

# Set to production when deploying
NODE_ENV=development
