# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rooted

# Port the API listens on (optional; hosts like Render set this automatically)
PORT=5000

# Comma-separated list of allowed browser origins (optional; defaults to all).
# In the single-service deploy the frontend is same-origin, so this can stay empty.
CORS_ORIGIN=http://localhost:3000

# Allow POST /api/books|clubs|stories to create content (default: false / read-only)
ENABLE_WRITES=false

# Local Ollama endpoint for Rooted AI features
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_MS=120000

# Set to production when deploying
NODE_ENV=development
