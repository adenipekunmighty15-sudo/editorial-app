# Base URL of the Rooted API backend.
# Leave empty in production (single-service deploy serves the API from the same origin).
# For local development with the backend on port 5000, set:
VITE_API_URL=http://localhost:5000

# Supabase (public anon key only - never put the service role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
